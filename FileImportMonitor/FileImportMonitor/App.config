<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!--
    Connection string to the ODBC data source that hosts
    LOCAL_IMPORTFILEVALIDMASKS. Point this at a DSN configured in the
    Windows ODBC Data Source Administrator, or use a DSN-less connection
    string for the appropriate ODBC driver.
  -->
  <connectionStrings>
    <add name="ImportValidationDb"
         connectionString="Dsn=YourOdbcDsn;Uid=your_user;Pwd=your_password;"
         providerName="System.Data.Odbc" />
  </connectionStrings>

  <appSettings>
    <!-- Directory that is watched for newly-arriving files. -->
    <add key="WatchDirectory" value="C:\Import\Inbox" />

    <!-- Directory that validated files are moved into. -->
    <add key="ImportDirectory" value="D:\IMPORT" />

    <!--
      Directory that files failing mask validation are moved into.
      Leave blank to leave rejected files in place (WatchDirectory) instead.
    -->
    <add key="RejectedDirectory" value="" />

    <!-- Table/column names holding the valid filename masks. -->
    <add key="MaskTableName" value="LOCAL_IMPORTFILEVALIDMASKS" />
    <add key="MaskColumnName" value="FILEMASK" />

    <!--
      Optional "is this mask active" column. Leave MaskActiveColumnName
      blank to select every row in the table unconditionally.
    -->
    <add key="MaskActiveColumnName" value="" />
    <add key="MaskActiveValue" value="Y" />

    <!-- How often (seconds) the mask list is re-read from the database. -->
    <add key="MaskRefreshIntervalSeconds" value="60" />

    <!--
      How long (seconds) to wait for a newly-arrived file to finish being
      written (i.e. no longer locked by the process creating it) before
      giving up on it.
    -->
    <add key="FileStabilizationTimeoutSeconds" value="30" />

    <!-- Process files already sitting in WatchDirectory at startup. -->
    <add key="ProcessExistingFilesOnStartup" value="true" />

    <!-- Log file path (relative paths are relative to the exe's folder). -->
    <add key="LogFilePath" value="Logs\FileImportMonitor.log" />
  </appSettings>
</configuration>
